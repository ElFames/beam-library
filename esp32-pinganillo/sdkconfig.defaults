# AP + STA simultáneos (el pinganillo reparte su propia red Y opcionalmente se
# engancha a la WiFi de casa para hacer de pasarela NAT hacia internet).
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# NAT: deja pasar tráfico IP entre la interfaz STA (internet real) y la AP (donde
# se cuelgan móvil/desktop), y traduce direcciones para que funcione sin que el
# router de casa sepa nada de la red del pinganillo.
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# El handshake de Beam usa EC P-256 + ECDSA + ECDH; el JSON de beacons/handshake
# necesita algo más de pila de lo que trae por defecto una tarea FreeRTOS típica.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# mbedTLS: curva P-256 y primitivas necesarias para el handshake (ECDH + ECDSA +
# AES-GCM + SHA-256). El resto de curvas/algoritmos no usados se pueden desactivar
# más adelante para ahorrar flash, pero de fábrica vienen todas activas.
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_GCM_C=y
